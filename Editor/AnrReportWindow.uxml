<engine:UXML xmlns:engine="UnityEngine.UIElements" xmlns:editor="UnityEditor.UIElements">
    <engine:VisualElement class="root">

        <engine:VisualElement class="header">
            <engine:VisualElement class="path-row">
                <engine:TextField label="Report" name="fieldReportPath" class="path-field" />
                <engine:Button text="Browse" name="btnBrowseReport" class="header-button" />
                <engine:Button text="Reload" name="btnReload" class="header-button" />
            </engine:VisualElement>
            <engine:VisualElement class="path-row">
                <engine:TextField label="Symbols" name="fieldSymbolsPath" class="path-field" />
                <engine:Button text="Browse" name="btnBrowseSymbols" class="header-button" />
                <engine:Button text="Resolve symbols" name="btnResolve" class="header-button" />
            </engine:VisualElement>
        </engine:VisualElement>

        <!-- Report metadata above, threads and their stacks below, both resizable. The tables
             themselves are built in code: MultiColumnListView does not exist in 2021.3. -->
        <engine:TwoPaneSplitView fixed-pane-index="0" fixed-pane-initial-dimension="150" orientation="Vertical">

            <engine:VisualElement name="metadataTable" class="pane" />

            <engine:VisualElement class="pane">
                <!-- Two toggles rather than a TabView, which arrived in Unity 6. -->
                <editor:Toolbar class="tabs">
                    <editor:ToolbarToggle name="toggleJavaThreads" text="Java threads" class="tab" />
                    <editor:ToolbarToggle name="toggleNativeThreads" text="Native threads" class="tab" />
                </editor:Toolbar>

                <engine:TwoPaneSplitView fixed-pane-index="0" fixed-pane-initial-dimension="340" orientation="Horizontal">

                    <engine:VisualElement class="pane">
                        <!-- One filter per tab, so a search in the Java threads does not follow you
                             into the native ones. Only the active tab's field is shown. -->
                        <editor:ToolbarSearchField name="fieldJavaThreadFilter" class="filter" />
                        <editor:ToolbarSearchField name="fieldNativeThreadFilter" class="filter" />
                        <engine:VisualElement name="threadsTable" class="pane" />
                    </engine:VisualElement>

                    <engine:VisualElement class="pane">
                        <engine:VisualElement name="javaStackTable" class="pane" />
                        <engine:VisualElement name="nativeStackTable" class="pane" />
                    </engine:VisualElement>

                </engine:TwoPaneSplitView>
            </engine:VisualElement>

        </engine:TwoPaneSplitView>

        <engine:Label name="labelStatus" class="status" />

    </engine:VisualElement>
</engine:UXML>
