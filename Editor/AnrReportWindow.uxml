<engine:UXML xmlns:engine="UnityEngine.UIElements" xmlns:editor="UnityEditor.UIElements">
    <engine:VisualElement class="root">

        <engine:VisualElement class="header">
            <engine:VisualElement class="path-row">
                <engine:TextField label="Report" name="fieldReportPath" class="path-field" />
                <engine:Button text="Browse" name="btnBrowseReport" class="header-button" />
                <engine:Button text="Reload" name="btnReload" class="header-button" />
            </engine:VisualElement>
            <engine:VisualElement class="path-row">
                <engine:TextField label="Symbols" name="fieldSymbolsPath" class="path-field" />
                <engine:Button text="Browse" name="btnBrowseSymbols" class="header-button" />
                <engine:Button text="Resolve symbols" name="btnResolve" class="header-button" />
            </engine:VisualElement>
        </engine:VisualElement>

        <!-- Report metadata above, threads and their stacks below, both resizable. -->
        <engine:TwoPaneSplitView fixed-pane-index="0" fixed-pane-initial-dimension="150" orientation="Vertical">

            <engine:MultiColumnListView name="listMetadata" show-alternating-row-backgrounds="All" class="list">
                <engine:Columns>
                    <engine:Column name="Name" title="Field" width="220" />
                    <engine:Column name="Value" title="Value" stretchable="true" />
                </engine:Columns>
            </engine:MultiColumnListView>

            <engine:VisualElement class="pane">
                <engine:TabView name="tabThreads" class="tabs">
                    <engine:Tab label="Java threads" name="tabJavaThreads" />
                    <engine:Tab label="Native threads" name="tabNativeThreads" />
                </engine:TabView>

                <engine:TwoPaneSplitView fixed-pane-index="0" fixed-pane-initial-dimension="340" orientation="Horizontal">

                    <engine:VisualElement class="pane">
                        <!-- One filter per tab, so a search in the Java threads does not follow you
                             into the native ones. Only the active tab's field is shown. -->
                        <editor:ToolbarSearchField name="fieldJavaThreadFilter" class="filter" />
                        <editor:ToolbarSearchField name="fieldNativeThreadFilter" class="filter" />
                        <engine:MultiColumnListView name="listThreads" show-alternating-row-backgrounds="All" class="list">
                            <engine:Columns>
                                <engine:Column name="Name" title="Thread" stretchable="true" />
                                <engine:Column name="Id" title="Id" width="64" />
                                <engine:Column name="State" title="State" width="104" />
                                <engine:Column name="Priority" title="Prio" width="48" />
                                <engine:Column name="Frames" title="Frames" width="58" />
                            </engine:Columns>
                        </engine:MultiColumnListView>
                    </engine:VisualElement>

                    <engine:VisualElement class="pane">
                        <engine:MultiColumnListView name="listJavaStack" show-alternating-row-backgrounds="All" class="list">
                            <engine:Columns>
                                <engine:Column name="Frame" title="#" width="38" />
                                <engine:Column name="Class" title="Class" stretchable="true" />
                                <engine:Column name="Method" title="Method" stretchable="true" />
                                <engine:Column name="Source" title="Source" width="220" />
                            </engine:Columns>
                        </engine:MultiColumnListView>
                        <engine:MultiColumnListView name="listNativeStack" show-alternating-row-backgrounds="All" class="list">
                            <engine:Columns>
                                <engine:Column name="Frame" title="#" width="38" />
                                <engine:Column name="Address" title="Address" width="140" />
                                <engine:Column name="Library" title="Library" width="170" />
                                <engine:Column name="Function" title="Function" stretchable="true" />
                                <engine:Column name="Source" title="Source" stretchable="true" />
                            </engine:Columns>
                        </engine:MultiColumnListView>
                    </engine:VisualElement>

                </engine:TwoPaneSplitView>
            </engine:VisualElement>

        </engine:TwoPaneSplitView>

        <engine:Label name="labelStatus" class="status" />

    </engine:VisualElement>
</engine:UXML>
